rning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment. ", "type": "text"}]}], "type": "DWS", "template_override": 1}], "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Out and About", "type": "lesson_name"}, {"content": "Do You Accept Credit Cards?", "type": "unit_name"}, {"content": 7, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately exchange information about buying things in communicative situations.", "type": "primary"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_1"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_2"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_3"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_4"}, {"content": "Understands key information in written texts about the communicative topics related to this level.     ", "type": "secondary_5"}, {"content": " Understands key information in written texts about the communicative topics related to this level.     ", "type": "secondary_6"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_7"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " The Modal Can for Possibility", "type": "heading"}, {"content": "The modal <span class = \"strong\">can</span> is used to ask and talk about what is possible. <br/><span class = \"italic\">Example: I can buy him a tie!</span>", "type": "describer"}, {"content": "Can you show me those ties? ", "type": "example"}, {"content": "You can buy this scarf and that tie. ", "type": "example"}, {"content": "Can I try this on?", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " These and Those", "type": "heading"}, {"content": "Demonstrative adjectives point something out. You use <span class = \"strong\">these</span> when things are close. You use <span class = \"strong\">those</span> when things are far.<br/>The demonstrative adjective goes in front of the noun.<br/><span class = \"italic\">these + noun (these ties)</span> or <span class = \"italic\">those + noun (those ties)</span>", "type": "describer"}, {"content": "{\"rows\":\"3\",\"columns\":\"3\",\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Demonstrative Adjective\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"near<br/>(here)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"these (socks)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class =\\\"italic\\\">These socks here are on sale.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"far<br/>(there)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"those (ties)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">I want to see those ties over there.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": " You make the negative form by adding <span class=\"strong\">not</span> to the verb.", "type": "text"}, {"content": "Those socks are <span class = \"strong\">not</span> on sale.", "type": "example"}, {"content": "I do <span class = \"strong\">not</span> like those ties at the back.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "final sale", "type": "name"}, {"content": "something you cannot return to the store for money or exchange", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: These shoes are a final sale.", "type": "example"}, {"content": "engenn2le05ob07aud02", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when items in shops are on sale.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "to be on sale", "type": "name"}, {"content": "the price is reduced", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: These are on sale for 50% off.", "type": "example"}, {"content": "engenn2le05ob07aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "purple", "type": "name"}, {"content": "a mix of red and blue", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: Her bag is purple!", "type": "example"}, {"content": "engenn2le05ob07aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "grey", "type": "name"}, {"content": " a mix of black and white", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: The sky is grey. It looks like rain.", "type": "example"}, {"content": "engenn2le05ob07aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "It suits you", "type": "name"}, {"content": "it looks good on you", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: That color looks good on you. It suits you.", "type": "example"}, {"content": "engenn2le05ob07aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to return", "type": "name"}, {"content": "to take back", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: You cannot return this item.", "type": "example"}, {"content": "engenn2le05ob07aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to try on", "type": "name"}, {"content": "to put on clothing in a store", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Can I try on this shirt, please?", "type": "example"}, {"content": "engenn2le05ob07aud08", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "on special", "type": "name"}, {"content": "at a reduced price", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: These ties are on special this week.", "type": "example"}, {"content": "engenn2le05ob07aud09", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to accept", "type": "name"}, {"content": "to take", "type": "definition"}, {"content": "(verb) ", "type": "part_speech"}, {"content": "Example: Do you accept credit cards?", "type": "example"}, {"content": "engenn2le05ob07aud01", "type": "audio"}]}, {"content": "engenn2le05ob07re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Look at a newspaper or magazine or look online.", "type": "text"}, {"content": "Find 6 pieces of clothing or accessory items.", "type": "text"}, {"content": "Write 3 item names in English and the sale price on one paper.", "type": "text"}, {"content": "Write 3 item names and their sale prices on a second paper.", "type": "text"}, {"content": "Put one paper in front of you.", "type": "text"}, {"content": "Put the second paper far from you.", "type": "text"}, {"content": "Say how much these/those items are. ", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I identify 6 items.", "type": "text"}, {"content": "I express how near or far the items are in my sentences about clothing and accessories. ", "type": "text"}, {"content": "I talk about the prices of items.", "type": "text"}]}], "type": "sena"}