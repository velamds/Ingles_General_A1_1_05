ents": [{"content": "Accurately use information about people, their likes and dislikes, homes or countries in communicative situations.", "type": "primary"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_1"}, {"content": "Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_2"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_3"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  ", "type": "secondary_4"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_5"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  ", "type": "secondary_6"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_7"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": "   The Present Continuous Tense for  Future Meaning", "type": "heading"}, {"content": "You use the Present Continuous tense to talk about things that are arranged, on the agenda or booked for the future.<br/>The Present Continuous tense also talks about actions happening now.", "type": "describer"}, {"content": "{\"rows\":\"2\",\"columns\":\"2\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Present Continuous <br>(for now)</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Present Continuous<br>(for the future)</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Hi! Where are you going?<br/><br/>He's reading the newspaper.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"They're going to the beach on Saturday.<br/><br/>She's seeing a movie with Tom tonight.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "There are bands playing on Saturday or Sunday, right?\u0000", "type": "example"}, {"content": "Wait, I'm checking online.\u000b\u0000", "type": "example"}, {"content": "Vanessa and I are going to the beach. \u0000", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Making Suggestions", "type": "heading"}, {"content": "You can make suggestions by saying:<br/>How about ... <br/>Let's ... <br/>What about ... <br/>We can ...", "type": "describer"}, {"content": "How about a movie?", "type": "example"}, {"content": "Let's go to a concert.", "type": "example"}, {"content": "What about staying home?", "type": "example"}, {"content": "We can go to an art show.", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "to check", "type": "name"}, {"content": "to look at", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Let's check the newspaper for sales!", "type": "example"}, {"content": "engenn2le05ob09aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use to talk about activities.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "event", "type": "name"}, {"content": "an important thing that happens", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: They have a sports event here once a year.", "type": "example"}, {"content": "engenn2le05ob09aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "listing", "type": "name"}, {"content": "an item in a list of information", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Look for the TV show listings in the newspaper.", "type": "example"}, {"content": "engenn2le05ob09aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "campus", "type": "name"}, {"content": "the school area and buildings", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: The college campus is not big.", "type": "example"}, {"content": "engenn2le05ob09aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to know", "type": "name"}, {"content": "to have information", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Do you know his name?", "type": "example"}, {"content": "engenn2le05ob09aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "date", "type": "name"}, {"content": "a romantic outing", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: They are on a date tonight.", "type": "example"}, {"content": "engenn2le05ob09aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "beach", "type": "name"}, {"content": "the sandy area beside the water", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We like to go to the beach in the summer.", "type": "example"}, {"content": "engenn2le05ob09aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "online", "type": "name"}, {"content": "on the Internet", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: Do you shop online?", "type": "example"}, {"content": "engenn2le05ob09aud08", "type": "audio"}]}, {"content": "engenn2le05ob09re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Find an event that is happening this week.", "type": "text"}, {"content": "Find a movie that is playing this week.", "ty