]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about people, their likes and dislikes, homes or countries in communicative situations."}, {"type": "secondary_1", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_2", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_3", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_4", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_5", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_6", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_7", "content": "Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_8", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": "  The Present Continuous Tense for Future Meaning"}, {"type": "describer", "content": "You use the Present Continuous tense to talk about things that are arranged, on the agenda or booked for the future.<br/><br/>The Present Continuous tense talks about actions happening now."}, {"type": "table", "content": "{\"rows\":\"2\",\"columns\":\"2\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Present Continuous (for now)<span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">Present Continuous (for the future)<span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">Hi! Where are you going?<br/><br/>He's reading the newspaper.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">They're going to the beach on Saturday.<br/><br/>She's seeing a movie with Tom tonight.</span>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class = \"strong\">Kirk</span>: What are you doing tomorrow?<br/><span class = \"strong\">Jessica</span>: I'm going to the beach."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " The Modal Can for Ability, Possibility and Permission"}, {"type": "describer", "content": "You use the modal <span class = \"strong\">can</span> to ask and talk about what is possible.  <br/>Example: <span class = \"italic\">I can buy him a tie!</span><br/><br/>You use the modal can to say you have an ability or know how to  do something. <br/><br/>You can use the modal can to ask for permission or give someone permission."}, {"type": "example", "content": "<span class = \"strong\">Possibility</span>: Can you show me those ties?"}, {"type": "example", "content": "<span class = \"strong\">Ability</span>: I can speak English!"}, {"type": "example", "content": "<span class = \"strong\">Permission</span>: <br/><span class = \"strong\">Alice</span>: \"Can I smoke here?\"<br/><span class = \"strong\">Mark</span>:\"No, you can't smoke here. You can smoke in the garden.\""}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to eat out"}, {"type": "definition", "content": "to have a meal at a restaurant"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: Let's eat dinner out at Mario's tonight!"}, {"type": "audio", "content": "engenn2le05ob11aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": " These are words to review."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "often"}, {"type": "definition", "content": "many times"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example:  We often go to the mall."}, {"type": "audio", "content": "engenn2le05ob11aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "all the time"}, {"type": "definition", "content": "regularly"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: I have sandwiches for lunch all the time."}, {"type": "audio", "content": "engenn2le05ob11aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to see"}, {"type": "definition", "content": "to watch"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: Let's see a movie."}, {"type": "audio", "content": "engenn2le05ob11aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "event"}, {"type": "definition", "content": "an important thing that happens"}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: They have a sports event here once a year."}, {"type": "audio", "content": "engenn2le05ob11aud05"}]}, {"type": "background_image", "content": "engenn2le05ob11re1img01.jpg"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Find an event near your city. "}, {"type": "text", "content": "Write a short dialogue between you and a friend."}, {"type": "text", "content": "Say when is the event on."}, {"type": "text", "content": "Say where is it."}, {"type": "text", "content": "Ask to use a friend's car to go there."}, {"type": "text", "content": "Read your dialogue aloud with a partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write about an event near my city."}, {"type": "text", "content": "I say where an event is."}, {"type": "text", "content": "I ask permission to use a car."}]}], "type": "sena"}