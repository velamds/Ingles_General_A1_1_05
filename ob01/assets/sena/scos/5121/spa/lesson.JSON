{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Out and About"}, {"type": "unit_name", "content": "This One or That One?"}, {"type": "position", "content": 1}, {"type": "origin", "content": "scholar > Here and There > Transportation"}, {"type": "lesson", "content": 5}, {"type": "level", "content": "A1.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Accurately use information about free-time activities or personal likes/dislikes in communicative situations."}, {"type": "secondary_1", "content": " Understands key information in written texts about the communicative topics related to this level."}, {"type": "secondary_2", "content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_3", "content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_4", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_5", "content": "Understands key information in written texts about the communicative topics related to this level.     "}, {"type": "secondary_6", "content": " Understands key information in written texts about the communicative topics related to this level.     "}, {"type": "secondary_7", "content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}, {"type": "secondary_8", "content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level."}]}, {"type": "learning_points", "contents": [{"type": "heading", "content": " Demonstrative Adjectives This and That"}, {"type": "describer", "content": "Demonstrative adjectives point something out. You use <span class = \"strong\">this</span> when something is close. You use <span class = \"strong\">that</span> when something is far.<br/>The demonstrative adjective goes in front of the noun.<br/>this + noun (this book) or that + noun  (that store)"}, {"type": "table", "content": "{\"rows\":\"3\",\"columns\":\"3\",\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Demonstrative Adjective\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"near<br/>(here)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"this (book) here\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">This lemon ice cream here is interesting</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"far<br/>(there/over there/back there)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"that (book) over there\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">That coffee icecream back there looks good.\\\"}\"],\"styles\":\" intro_table_border\"}"}, {"type": "text", "content": "You make the negative form by adding <span class = \"strong\">not</span> after the verb."}, {"type": "example", "content": "That shop over there is <span class = \"strong\">not</span> expensive."}, {"type": "example", "content": "This one here does <span class = \"strong\">not</span> have cheaper food."}, {"type": "example", "content": "This one here is strawberry mango. "}, {"type": "example", "content": "That one at the back is mocha crunch! "}]}, {"type": "target_word", "contents": [{"type": "name", "content": "flavor"}, {"type": "definition", "content": "the taste of a food"}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: My favorite flavor is strawberry."}, {"type": "audio", "content": "engenn2le05ob01aud01"}]}, {"type": "target_word_describer", "c