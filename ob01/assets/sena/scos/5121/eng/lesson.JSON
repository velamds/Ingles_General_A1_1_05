{"_data": [{"type": "metadata", "contents": [{"content": "Out and About", "type": "lesson_name"}, {"content": "This One or That One?", "type": "unit_name"}, {"content": 1, "type": "position"}, {"content": "scholar > Here and There > Transportation", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately use information about free time activities or personal likes/dislikes in communicative situations.", "type": "primary"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_1"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_2"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_3"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_4"}, {"content": "Understands key information in written texts about the communicative topics related to this level.     ", "type": "secondary_5"}, {"content": " Understands key information in written texts about the communicative topics related to this level.     ", "type": "secondary_6"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_7"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " Demonstrative Adjectives This and That", "type": "heading"}, {"content": "Demonstrative adjectives point something out. You use <span class = \"strong\">this</span> when something is close. You use <span class = \"strong\">that</span> when something is far.<br/>The demonstrative adjective goes in front of the noun.<br/><span class = \"strong\">this</span> + noun (this book) or<span class = \"strong\"> that</span> + noun  (that store)", "type": "describer"}, {"content": "{\"rows\":\"3\",\"columns\":\"3\",\"cells\":[\"\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Demonstrative Adjective\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"near<br/>(here)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"this (book) here\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">This lemon ice cream here is interesting.</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"far<br/>(there/over there/back there)\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"that (book) over there\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"italic\\\">That coffee ice cream back there looks good.\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "You make the negative form by adding <span class = \"strong\">not</span> after the verb.", "type": "text"}, {"content": "That shop over there is <span class = \"strong\">not</span> expensive.", "type": "example"}, {"content": "This one here does <span class = \"strong\">not</span> have cheaper food.", "type": "example"}, {"content": "This one here is strawberry mango. ", "type": "example"}, {"content": "That one at the back is mocha crunch! ", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "flavor", "type": "name"}, {"content": "the taste of a food", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: My favorite flavor is strawberry.", "type": "example"}, {"content": "engenn2le05ob01aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you use when you go sightseeing.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "both", "type": "name"}, {"content": "two people together", "type": "definition"}, {"content": "(pronoun)", "type": "part_speech"}, {"content": "Example: We both like coffee ice cream.", "type": "example"}, {"content": "engenn2le05ob01aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "right here", "type": "name"}, {"content": "in this place", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: Stop. The restaurant is right here.", "type": "example"}, {"content": "engenn2le05ob01aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "music festival", "type": "name"}, {"content": "an event where different bands play music", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I go to the music festival in the park every year.", "type": "example"}, {"content": "engenn2le05ob01aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to visit", "type": "name"}, {"content": "to go to a place", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: Let's visit the gallery tomorrow.", "type": "example"}, {"content": "engenn2le05ob01aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "museum", "type": "name"}, {"content": "a building to see art or historic items", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We can see the dinosaurs at the museum.", "type": "example"}, {"content": "engenn2le05ob01aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "show", "type": "name"}, {"content": "a concert; a play; a performance; an art exhibit", "type": "definition"}, {"conten