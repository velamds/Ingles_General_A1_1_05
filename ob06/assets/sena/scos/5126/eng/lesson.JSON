data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Out and About", "type": "lesson_name"}, {"content": "Does This Come in Black?", "type": "unit_name"}, {"content": 6, "type": "position"}, {"content": "scholar > Daily Life > Pronunciation 2", "type": "origin"}, {"content": 5, "type": "lesson"}, {"content": "A1.1", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": "Accurately exchange information about buying things in communicative situations.", "type": "primary"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.", "type": "secondary_1"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_2"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_3"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  ", "type": "secondary_4"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  ", "type": "secondary_5"}, {"content": "Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  ", "type": "secondary_6"}, {"content": " Understands simple information in slow conversations about the communicative topics and vocabulary related to this level.  ", "type": "secondary_7"}, {"content": " Understands key information in written texts about the communicative topics related to this level.", "type": "secondary_8"}]}, {"type": "learning_points", "contents": [{"content": " Wh- Questions -  Asking How Much Things Cost", "type": "heading"}, {"content": "You use <span class = \"strong\">how much</span> to ask about prices.<br/>This is not a yes or no question. It asks for information.<br/>You can use a singular or plural verb with <span class = \"strong\">how much</span>.<br/>When you ask about a second item, you can say <span class = \"italic\">What about \u2026 ?</span>", "type": "describer"}, {"content": "{\"rows\":\"2\",\"columns\":\"1\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class = \\\"strong\\\">How...</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"How much is it?<br/>How much are they?<br/><br/>How much is \u2026 ?<br/>How much are \u2026 ?\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}, {"content": "How much is this shirt?", "type": "example"}, {"content": "How much are the socks?", "type": "example"}, {"content": "What about the T-shirts?", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Saying How Much Things Cost", "type": "heading"}, {"content": "When you say how much things cost, you talk about money.<br/>There are different ways to say an amount of money.", "type": "describer"}, {"content": "{\"rows\":\"2\",\"columns\":\"2\",\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Amount\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"What You Say\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"$20<br/>$20.50<br/><br/><br/>$105<br/><br/><br/><br/>$105.50\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"twenty dollars<br/>twenty dollars and fifty cents<br/>twenty fifty<br/><br/>one hundred and five dollars<br/>one hundred and five<br/>one o five<br/><br/>one hundred and five dollars and fifty cents<br/>one hundred and five fifty<br/>one o five fifty\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "target_word", "contents": [{"content": "scarf", "type": "name"}, {"content": "a cloth to keep your neck warm", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: This scarf looks nice with your coat.", "type": "example"}, {"content": "engenn2le05ob06aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you hear when you shop for clothing and accessories.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "tie", "type": "name"}, {"content": "a thing to wear around your neck with your business suit", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: He always wears a tie to work.", "type": "example"}, {"content": "engenn2le05ob06aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "yellow", "type": "name"}, {"content": "the color of a lemon", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: She has a yellow umbrella.", "type": "example"}, {"content": "engenn2le05ob06aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "black", "type": "name"}, {"content": "the color of the sky at night", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: He always wears black shoes. ", "type": "example"}, {"content": "engenn2le05ob06aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "red", "type": "name"}, {"content": "the color of blood", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I have a red and black scarf.", "type": "example"}, {"content": "engenn2le05ob06aud05", "type": "audio"}]}, {"content": "engenn2le05ob06re1img01.jpg", "type": "background_image"}, {"type": "takeaway_extension", "contents": [{"content": "Look online or in a store at accessories.", "type": "text"}, {"content": "Look at scarves, ties, gloves and belts.", "type": "text"}, {"content": "Find a good price for each item.", "type": "text"}, {"content": "Find a high price for each item.", "type": "text"}, {"content": " Write short dialogues asking about the prices.", "type": "text"}, {"content": "Practice your dialogue with a partner.", "type": "text"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I identify accessories online or in a store. ", "type": "text"}, {"content": "I write short dialogues asking for and giving the prices of items.", "type": "text"}, {"content": "I read my dialogue out loud with a partner.", "type": "text"}]}]}